{
  "manifest_version": 3,
  "name": "Soma for Canvas",
  "version": "0.1.0",
  "description": "Brings your Canvas and Gradescope assignments, submissions, grades and announcements into Soma. Reads them in your browser only, with your own sign-in.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://www.gradescope.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "js": [
        "common.js",
        "canvas.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.gradescope.com/*"
      ],
      "js": [
        "common.js",
        "gradescope.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://somastudy.app/*",
        "https://www.somastudy.app/*",
        "http://localhost:5173/*",
        "http://localhost:5174/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Soma for Canvas"
  },
  "background": {
    "service_worker": "background.js"
  }
}
